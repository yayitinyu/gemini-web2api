# Required: use at least 12 characters. Keep this file outside version control as .env.
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Optional: if empty on first start, a key is generated once and printed to container logs.
API_KEY=

# Optional: base64-encoded 32-byte key. If empty, a persistent key is created under /data.
DATA_ENCRYPTION_KEY=

# Safe default for a local reverse proxy. Set 0.0.0.0 only when direct public binding is intentional.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Set both to true when a trusted HTTPS reverse proxy is in front of the container.
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

SESSION_TTL=24h
MAX_REQUEST_BODY_BYTES=16777216
